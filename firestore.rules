rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    match /config/public {
      allow read: if true;
      allow write: if admin();
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if admin() || (signedIn() && request.auth.uid == uid);
    }
    match /admins/{uid} { allow read: if signedIn() && (request.auth.uid == uid || admin()); allow write: if admin(); }
    match /deposits/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if admin();
    }
    match /withdrawals/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if admin();
    }
    match /transactions/{id} { allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid); allow create: if admin(); }
    match /notifications/{id} { allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid); allow create: if admin() || (signedIn() && request.resource.data.uid == request.auth.uid); allow update: if admin() || (signedIn() && resource.data.uid == request.auth.uid); }
    match /rates/{id} { allow read: if true; allow write: if admin(); }
    match /{document=**} { allow read, write: if false; }
  }
}